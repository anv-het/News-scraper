# ============================================================
# Groww Scraper Configuration
# ============================================================

# --- Output Settings ---
OUTPUT_DIR=C:\Users\aaa\Desktop\News\groww\output
OUTPUT_FORMAT=both
# json, csv, or both

# --- Stock Scraper Settings ---
PAGE_SIZE=50
SORT_BY=NA
SORT_TYPE=ASC

# --- Stock Filter Settings ---
MIN_PRICE=0
MAX_PRICE=500000
MIN_MARKET_CAP=0
MAX_MARKET_CAP=3000000000000000

# --- News Settings ---
NEWS_JSON_DIR=C:\Users\aaa\Desktop\News\groww\output\news\json
NEWS_CSV_DIR=C:\Users\aaa\Desktop\News\groww\output\news\csv
NEWS_PAGE_SIZE=50

# --- Delay Settings ---
# Random delay between each API request (seconds)
MIN_DELAY=2
MAX_DELAY=8
REQUEST_TIMEOUT=30

# --- Break Settings ---
# Take a random break after every N stocks
BREAK_AFTER_STOCKS=50
# Break duration range (minutes)
BREAK_MIN_MINUTES=5
BREAK_MAX_MINUTES=15

# --- Cron Job Settings ---
CRON_ENABLED=false
# Gap between runs in days
CRON_DAY_GAP=1
# Time window for random run time (24h format HH:MM)
CRON_START_TIME=09:00
CRON_END_TIME=20:00

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true

# --- MongoDB (news only) ---
MONGODB_ENABLED=true
MONGODB_URL=mongodb://sa:963852@192.168.102.120
MONGODB_DATABASE=WEB_SCRAPING
MONGODB_COLLECTION=groww_news
