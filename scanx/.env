# Random delay between each ISIN fetch (seconds)
FETCH_MIN_DELAY=2
FETCH_MAX_DELAY=10

# Break after every N fetches
BATCH_SIZE=100
BREAK_MIN_MINUTES=5
BREAK_MAX_MINUTES=15

# MongoDB Configuration
MONGODB_ENABLED=false
MONGODB_URL=mongodb://sa:963852@192.168.102.120
MONGODB_DATABASE=WEB_SCRAPING
MONGODB_COLLECTION=scanx_news

# Cron Job Settings (system local time, 24-hour format)
CRON_ENABLED=false
CRON_START_HOUR=9
CRON_END_HOUR=18
CRON_DAYS_GAP=1
