# Investing.com Scraper Configuration

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================
# Base output directory
OUTPUT_DIR=/DATA/News-scraper/investing_com/Output

# JSON output directory (for news JSON files)
JSON_OUTPUT_DIR=/DATA/News-scraper/investing_com/Output/Json_files

# CSV output directory (for news CSV files)
CSV_OUTPUT_DIR=/DATA/News-scraper/investing_com/Output/csv_files

# Equities JSON file path
EQUITIES_JSON=/DATA/News-scraper/investing_com/equities_india_latest.json
# Log files directory
LOG_DIR=/DATA/News-scraper/investing_com/Logs

# Enable CSV output in addition to JSON
ENABLE_CSV_OUTPUT=true

# =============================================================================
# DELAY SETTINGS
# =============================================================================
PAGE_DELAY_MIN=2
PAGE_DELAY_MAX=5
EQUITY_DELAY_MIN=2
EQUITY_DELAY_MAX=10
BATCH_SIZE=50
BREAK_MIN_MINUTES=5
BREAK_MAX_MINUTES=15
REQUEST_TIMEOUT=60

# =============================================================================
# SCRAPER SETTINGS
# =============================================================================
MAX_PAGES_PER_EQUITY=100
TEST_MODE=false
TEST_LIMIT=5
SKIP_EXISTING=true

# =============================================================================
# CRON / SCHEDULING SETTINGS
# =============================================================================
CRON_ENABLED=false
CRON_START_HOUR=9
CRON_END_HOUR=22
CRON_DAYS_GAP=1
CRON_RANDOM_START_DELAY_MAX=30

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_TO_FILE=true

# =============================================================================
# MONGODB SETTINGS
# =============================================================================
# Enable MongoDB storage (in addition to JSON files)
MONGODB_ENABLED=false

# MongoDB connection URL
MONGODB_URL=mongodb://localhost:27017

# Database name
MONGODB_DATABASE=investing_scraper

# Collection names
MONGODB_EQUITIES_COLLECTION=equities
MONGODB_NEWS_COLLECTION=news
