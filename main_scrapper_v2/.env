# ╔══════════════════════════════════════════════════════════════════════╗
# ║                    NEWS SCRAPPER CONFIGURATION                      ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── General ──────────────────────────────────────────────────────────
PROJECT_NAME=NewsScrapper
LOG_LEVEL=INFO
DATA_DIR=F:/NEWS/main_scrapper_v2/DATA
LOG_DIR=F:/NEWS/main_scrapper_v2/LOGS
TIMEZONE=Asia/Kolkata

# ── Dashboard / API Server ───────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_HOST=192.168.119.202
DASHBOARD_PORT=8080

# ── Redis ────────────────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://192.168.102.233:6379/0
REDIS_PREFIX=news_scrapper
REDIS_SEEN_TTL_DAYS=60

# - MongoDB
MONGO_ENABLED=true
MONGO_URL=mongodb://sa:963852@192.168.102.120/
MONGO_DATABASE=WEB_CRAWLER
MONGO_COLLECTION=news_sources
MONGO_TOP_NEWS_ENABLED=true
MONGO_TOP_NEWS_COLLECTION=top_news

# - Top News Output
GENERATE_TOP_NEWS_JSON=true

# ── Proxy ────────────────────────────────────────────────────────────
PROXY_ENABLED=true
PROXY_FILE=proxies.txt
PROXY_BANDWIDTH_LIMIT_MB=1024
PROXY_ROTATION=round_robin

# ── Quiet Hours (IST, 24h format) ────────────────────────────────────
# Scraping pauses between START and END. Leave empty to disable.
# Example: QUIET_HOURS_START=23:30  QUIET_HOURS_END=06:00
QUIET_HOURS_START=19:00
QUIET_HOURS_END=08:30

# ── Scraper Defaults ─────────────────────────────────────────────────
DEFAULT_TIMEOUT=10
DEFAULT_POLL_MIN=2
DEFAULT_POLL_MAX=4
MAX_RETRIES=3
MAX_CONSECUTIVE_ERRORS=20
BLOCKED_THRESHOLD_MINUTES=120
BACKUP_WRITE_INTERVAL=60

# ── Blocked Site Exponential Backoff ─────────────────────────────────
# When a site is blocked, delay starts random between MIN..MAX minutes
# and escalates by FACTOR on each consecutive block, up to MAX_DELAY.
BLOCKED_DELAY_MIN=10
BLOCKED_DELAY_MAX=30
BLOCKED_ESCALATION_FACTOR=2
BLOCKED_MAX_DELAY_MIN=120

# ── User Agent ───────────────────────────────────────────────────────
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36

